{
  "name": "btp-cap-rag-ai",
  "version": "1.0.0",
  "description": "SAP CAP + SAP BTP AI Core = RAG AI Workshop",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "dependencies": {
    "@langchain/community": "^0.3.42",
    "@langchain/textsplitters": "^0.1.0",
    "@sap-cloud-sdk/http-client": "^4.0.2",
    "@sap/cds": "^8.9.3",
    "@sap/cds-hana": "^2.0.0",
    "@sap/xsenv": "^5.6.0",
    "@sap/xssec": "^4.7.0",
    "cap-llm-plugin": "^1.5.0",
    "express": "^4.21.2",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@cap-js/cds-types": "^0.10.0",
    "@cap-js/sqlite": "^1.11.0",
    "@sap/cds-dk": "^8.9.3",
    "@sap/ux-specification": "^1.124.15",
    "eslint": "^9.26.0",
    "eslint-config-mlauffer-ui5": "^2.1.0",
    "mbt": "^1.2.34",
    "prettier": "^3.5.3",
    "chai": "^5.2.0",
    "chai-http": "^5.1.2",
    "sinon": "^20.0.0"
  },
  "scripts": {
    "start": "cds-serve",
    "hybrid": "cds watch --profile hybrid",
    "test": "cds watch --profile test",
    "lint": "prettier . --check --cache && eslint --cache",
    "pretty": "prettier . --write --cache",
    "build": "mbt build -t gen --mtar archive",
    "deploy": "cf deploy gen/archive.mtar --retries 1 --delete-services",
    "undeploy": "cf undeploy btp-cap-rag-ai-001 --delete-services --delete-service-keys --delete-service-brokers"
  },
  "sapux": [
    "app/embedding",
    "app/chat"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mauriciolauffer/btp-cap-rag-ai-workshop.git"
  },
  "bugs": {
    "url": "https://github.com/mauriciolauffer/btp-cap-rag-ai-workshop/issues"
  }
}
