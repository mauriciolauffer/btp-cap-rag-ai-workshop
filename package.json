  "description": "SAP CAP + SAP BTP AI Core = RAG AI Workshop",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "dependencies": {
    "@langchain/community": "^0.3.37",
    "@langchain/textsplitters": "^0.1.0",
    "@sap-cloud-sdk/http-client": "^3.26.4",
    "@sap/cds": "^8.8.3",
    "@sap/cds-hana": "^2.0.0",
    "@sap/xsenv": "^5.5.0",
    "@sap/xssec": "^4.5.0",
    "cap-llm-plugin": "^1.4.5",
    "express": "^4.21.2",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@cap-js/cds-types": "^0.9.0",
    "@cap-js/sqlite": "^1.9.0",
    "@sap/cds-dk": "^8.8.2",
    "@sap/ux-specification": "^1.124.12",
    "eslint": "^9.23.0",
    "eslint-config-mlauffer-ui5": "^2.1.0",
    "mbt": "^1.2.34",
    "prettier": "^3.5.3"
  },
  "scripts": {
    "start": "cds-serve",
    "hybrid": "cds watch --profile hybrid",
    "lint": "eslint --cache",
    "build": "mbt build -t gen --mtar archive",
